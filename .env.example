APP_NAME=ParsaGate
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=skynet
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# F10-B Remnawave read-only inspection (credentials stay in local/secret ENV only).
# Use a dedicated scoped API token for health/nodes/hosts/squads/config profiles.
REMNAWAVE_PANEL_URL=
REMNAWAVE_API_TOKEN=
REMNAWAVE_TIMEOUT=15
# CRITICAL: keep false until a separate test panel, token scopes and manual E2E are verified.
REMNAWAVE_WRITES_ENABLED=false
# Separate default-off gates for trusted Admin SSH readiness and VPS installation.
NODE_SSH_SETUP_ENABLED=false
NODE_SSH_INSTALL_ENABLED=false
REMNAWAVE_SQUAD_BINDINGS_LIVE_VERIFIED=false

# Telegram (never commit real credentials)
TELEGRAM_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
# Exact BotFather username, without @, used for invite links.
TELEGRAM_BOT_USERNAME=
# Opt-in after operator accounts are linked. No automatic signup on /start: user must confirm.
TELEGRAM_PUBLIC_SIGNUP_ENABLED=false
# Opt-in role-aware persistent Reply Keyboard; default OFF for safe rollout.
TELEGRAM_HYBRID_MENU_ENABLED=false
# MB-02: second Telegram runtime exists but is OFF and has no customer handlers.
# Never reuse the Admin bot's token or secret. Do not enable until approved.
TELEGRAM_SALES_ENABLED=false
TELEGRAM_SALES_TOKEN=
TELEGRAM_SALES_WEBHOOK_SECRET=
TELEGRAM_SALES_BOT_USERNAME=
TELEGRAM_SALES_SUPPORT_USERNAME=

# Trusted Telegram numeric IDs for elevated Super Admin checks; configure >=2 in production.
SUPER_ADMIN_TELEGRAM_IDS=

# F08 prepaid reseller wallet: keep disabled until bank account, review procedure and E2E are verified.
BILLING_TOPUPS_ENABLED=false
# Short bank-transfer instructions displayed to a reseller. Never commit real bank/account details.
BILLING_PAYMENT_INSTRUCTIONS=
BILLING_PAYMENT_CARD_NUMBER=

# F11-A1 internal-only wallet settlement; never enable before bank/DB/staging E2E sign-off.
SALES_WALLET_SETTLEMENT_ENABLED=false

# F11-A2 receipt review and direct bank settlement; OFF until bank and staging validation.
SALES_MANUAL_BANK_REVIEW_ENABLED=false

# MB-05A: durable notification outbox is recorded even when delivery is OFF.
# Enable only after DB migration, working database queue worker and bot tests.
TELEGRAM_NOTIFICATIONS_ENABLED=false
