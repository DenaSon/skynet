APP_NAME=DenaGate
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=skynet
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# CF-01: optional, scoped Cloudflare DNS for new servers; default OFF.
# Token needs Zone Read + DNS Write, restricted to the exact permitted zones.
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ALLOWED_ZONES=denagate.ir,atel.ir
CLOUDFLARE_DNS_WRITES_ENABLED=false

# F10-B Remnawave read-only inspection (credentials stay in local/secret ENV only).
# Use a dedicated scoped API token for health/nodes/hosts/squads/config profiles.
REMNAWAVE_PANEL_URL=
REMNAWAVE_API_TOKEN=
REMNAWAVE_TIMEOUT=15
# MVP default ON per operator approval. This is a shared Remnawave write switch:
# it also allows explicitly authorized Admin Node/Host mutations.
# Set false to disable all RW writes; an existing explicit false overrides the default.
REMNAWAVE_WRITES_ENABLED=true
# Separate default-off gates for trusted Admin SSH readiness and VPS installation.
NODE_SSH_SETUP_ENABLED=false
NODE_SSH_INSTALL_ENABLED=false
REMNAWAVE_SQUAD_BINDINGS_LIVE_VERIFIED=true

# Telegram (never commit real credentials)
TELEGRAM_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
# Exact BotFather username, without @, used for invite links.
TELEGRAM_BOT_USERNAME=
# Opt-in after operator accounts are linked. No automatic signup on /start: user must confirm.
TELEGRAM_PUBLIC_SIGNUP_ENABLED=false
# Opt-in role-aware persistent Reply Keyboard; default OFF for safe rollout.
TELEGRAM_HYBRID_MENU_ENABLED=false
# MB-02: second Telegram runtime exists but is OFF and has no customer handlers.
# Never reuse the Admin bot's token or secret. Do not enable until approved.
TELEGRAM_SALES_ENABLED=false
TELEGRAM_SALES_TOKEN=
TELEGRAM_SALES_WEBHOOK_SECRET=
TELEGRAM_SALES_BOT_USERNAME=
TELEGRAM_SALES_SUPPORT_USERNAME=

# Trusted Telegram numeric IDs for elevated Super Admin checks; configure >=2 in production.
SUPER_ADMIN_TELEGRAM_IDS=

# F08 prepaid reseller wallet: keep disabled until bank account, review procedure and E2E are verified.
BILLING_TOPUPS_ENABLED=false
# Short bank-transfer instructions displayed to a reseller. Never commit real bank/account details.
BILLING_PAYMENT_INSTRUCTIONS=
BILLING_PAYMENT_CARD_NUMBER=

# F11-A1 internal-only wallet settlement; never enable before bank/DB/staging E2E sign-off.
SALES_WALLET_SETTLEMENT_ENABLED=false

# F11-A2 receipt review and direct bank settlement; OFF until bank and staging validation.
SALES_MANUAL_BANK_REVIEW_ENABLED=false
# CLOSE-01: the only Admin bank-review UX is single-decision Approve/Reject.
# MVP: immediate review + queued provisioning are ON by default.
# The admin must independently verify a real bank transfer before approval.
# Live RW writes require a connected panel, verified plan/Squad binding and a queue worker.
# Explicit false still disables each capability for rollback.
SALES_ONE_CLICK_BANK_REVIEW_ENABLED=true
SALES_AUTO_FULFILLMENT_ENABLED=true
# UXR-05: Domain only, no scheme/path/port. Enable the page button ONLY after
# the official Remnawave Subscription Page is live with this exact URL host.
SALES_SUBSCRIPTION_PAGE_HOST=

# MB-05A: durable notification outbox is recorded even when delivery is OFF.
# Enable only after DB migration, working database queue worker and bot tests.
TELEGRAM_NOTIFICATIONS_ENABLED=false

# Free trial: keep OFF until separate live Telegram/Remnawave acceptance.
TRIAL_ENABLED=false
TRIAL_DAILY_LIMIT=20
TRIAL_PHONE_HMAC_KEY=
TRIAL_INTERNAL_SQUAD_UUID=
TRIAL_VERIFIED_SQUAD_UUID=

# Referral rewards foundation only; enable after REF-02/03 acceptance.
REFERRAL_REWARDS_ENABLED=false
REFERRAL_REWARD_TOMANS=30000
REFERRAL_MAX_REWARDS_PER_REFERRER=7
# Explicit UTC rollout timestamp, e.g. YYYY-MM-DDTHH:MM:SSZ; blank fails closed.
REFERRAL_REWARDS_START_AT=
